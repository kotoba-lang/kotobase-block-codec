{:paths ["src"]
 :version "0.1.0"
 ;; org-ietf-deflate is a HARD dependency at a PINNED sha, not an injected
 ;; codec, and the pin is load-bearing: this compressor's exact output bytes
 ;; are inside every CID it frames. `golden_test` fails if the pin moves in a
 ;; way that changes them.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}io.github.kotoba-lang/org-ietf-deflate
        {:git/url "https://github.com/kotoba-lang/org-ietf-deflate.git"
         :git/sha "e7558036709b673e22673fc2bbd12f3a24144e98"}
        ;; `kotobase.blockcodec.node` only: the DAG-CBOR envelope that keeps a
        ;; compressed block a valid block, and its link-visibility check.
        ;; `kotobase.blockcodec.core` stays dependency-free of it.
        io.github.kotoba-lang/io-ipld
        {:git/url "https://github.com/kotoba-lang/io-ipld.git"
         :git/sha "48ba40490cf082a1473986ac757b8e2b214a3d1b"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
